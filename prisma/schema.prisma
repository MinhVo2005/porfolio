// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int    @id @default(autoincrement())
  name        String
  location    String
  jobTitle    String
  description String
  cvs CV[]
  contacts Contact[]
  experiences Experience[]
  skills Skill[]
  projects Project[]
  awards Award[]
  educations Education[]
}

model CV {
  id     Int    @id @default(autoincrement())
  lang   String @unique
  url    String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}

model Contact {
  id          Int         @id @default(autoincrement())
  type        ContactType
  contactInfo String
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  position    String
  description String
  highlight   String[]
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  skills      Skill[]
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  displayName String
  description String
  highlights  String[]
  githubUrl   String?
  img         String[]
  featured    Boolean       @default(false)
  category    String
  status      ProjectStatus @default(SHIPPED)
  order       Int           @default(0)
  user        User          @relation(fields: [userId], references: [id])
  userId      Int
  skills      Skill[]
}

model Award {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  event       String
  description String
  url         String?
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
}

model Education {
  id             Int       @id @default(autoincrement())
  school         String
  degree         String
  field          String
  minor          String?
  gpa            Float?
  startDate      DateTime
  graduationDate DateTime?
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
}

model Skill {
  id          Int          @id @default(autoincrement())
  name        String
  category    String
  proficiency Proficiency  @default(INTERMEDIATE)
  description String?
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  projects    Project[]
  experiences Experience[]
}

enum ContactType {
  GITHUB @map("Github")
  EMAIL @map("Email")
  LINKEDIN @map("LinkedIn")
}

enum ProjectStatus {
  RUNNING  @map("running")
  SHIPPED  @map("shipped")
  ARCHIVED @map("archived")
}

enum Proficiency {
  PRIMARY      @map("primary")
  PROFICIENT   @map("proficient")
  INTERMEDIATE @map("intermediate")
}